---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-900/60 p-5 shadow-lg">
      <h2 class="mb-4 text-xl font-semibold text-slate-100">Filter games</h2>
      <form data-testid="game-filters-form" class="grid gap-4 md:grid-cols-2" method="get">
        <div class="space-y-2">
          <label for="category-filter" class="block text-sm font-medium text-slate-200">Categories</label>
          <select
            id="category-filter"
            name="category"
            multiple
            size={Math.min(categories.length, 6)}
            data-testid="category-filter"
            aria-label="Filter games by category"
            class="w-full rounded-lg border border-slate-600 bg-slate-950 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            {categories.map((category) => (
              <option value={category.id}>{category.name}</option>
            ))}
          </select>
        </div>

        <div class="space-y-2">
          <label for="publisher-filter" class="block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-950 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <div class="md:col-span-2 flex flex-wrap gap-3">
          <button
            type="submit"
            data-testid="apply-filters-button"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
          >
            Apply filters
          </button>
          <button
            type="reset"
            data-testid="clear-filters-button"
            class="rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 font-medium text-slate-100 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
          >
            Clear filters
          </button>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <EmptyState text="No games match the selected filters." hidden={games.length > 0} />
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        data-testid="games-grid"
        hidden={games.length === 0}
      >
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </div>

  <script>
    const form = document.querySelector('[data-testid="game-filters-form"]');
    const categoryFilter = document.querySelector('[data-testid="category-filter"]');
    const publisherFilter = document.querySelector('[data-testid="publisher-filter"]');

    if (form instanceof HTMLFormElement && categoryFilter instanceof HTMLSelectElement && publisherFilter instanceof HTMLSelectElement) {
      const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]')) as HTMLElement[];
      const gamesGrid = document.querySelector('[data-testid="games-grid"]') as HTMLElement | null;
      const emptyState = document.querySelector('[data-testid="empty-state"]') as HTMLElement | null;

      const applyFilters = () => {
        const selectedCategories = new Set(
          Array.from(categoryFilter.selectedOptions).map((option) => Number.parseInt(option.value, 10)),
        );
        const selectedPublisher = publisherFilter.value
          ? Number.parseInt(publisherFilter.value, 10)
          : null;
        let visibleCount = 0;

        gameCards.forEach((card) => {
          const categoryId = Number.parseInt(card.dataset.gameCategoryId ?? '', 10);
          const publisherId = Number.parseInt(card.dataset.gamePublisherId ?? '', 10);
          const matchesCategory = selectedCategories.size === 0 || selectedCategories.has(categoryId);
          const matchesPublisher = selectedPublisher === null || publisherId === selectedPublisher;
          const isVisible = matchesCategory && matchesPublisher;

          card.hidden = !isVisible;
          if (isVisible) {
            visibleCount += 1;
          }
        });

        if (gamesGrid) {
          gamesGrid.hidden = visibleCount === 0;
        }

        if (emptyState) {
          emptyState.hidden = visibleCount > 0;
        }
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        applyFilters();
      });

      categoryFilter.addEventListener('change', applyFilters);
      publisherFilter.addEventListener('change', applyFilters);

      document.querySelector('[data-testid="clear-filters-button"]')?.addEventListener('click', () => {
        categoryFilter.selectedIndex = -1;
        publisherFilter.value = '';
        applyFilters();
      });

      applyFilters();
    }
  </script>
</Layout>
